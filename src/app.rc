#include <winres.h>
#include "version.h"

1 ICON "..\\assets\\app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ASMEDITOR_VERSION_MAJOR, ASMEDITOR_VERSION_MINOR, ASMEDITOR_VERSION_PATCH, 0
PRODUCTVERSION ASMEDITOR_VERSION_MAJOR, ASMEDITOR_VERSION_MINOR, ASMEDITOR_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "FileDescription", "AsmEditor - NASM editor and debugger"
            VALUE "ProductName", "AsmEditor"
            VALUE "FileVersion", ASMEDITOR_VERSION_TEXT
            VALUE "ProductVersion", ASMEDITOR_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
